# Agent wallet: holds a little NGT on Base. Signs payments; needs no ETH.
AGENT_PRIVATE_KEY=

# Seller: wallet that receives NGT, and the key that submits settlement (needs a little Base ETH).
SELLER_PAY_TO=
FACILITATOR_KEY=

# Optional
PRICE_NGT=0.001
# Preferred seller port. If it is taken, the seller uses the next free one and prints the URL.
PORT=4021
BASE_RPC_URL=https://mainnet.base.org
